  "customCss": "/* HANCOM Blog visual reconstruction\n   * Source: 3 supplied HANCOM Blog full-page screenshots.\n   * Optimized for article/document rendering.\n   */\n:root {\n  --hancom-bg: #f5f5f5;\n  --hancom-surface: #ffffff;\n  --hancom-text: #222222;\n  --hancom-body: #333333;\n  --hancom-muted: #777777;\n  --hancom-border: #e5e5e5;\n  --hancom-orange: #f15a24;\n  --hancom-blue: #2878d4;\n  --hancom-dark: #202020;\n}\n\nbody {\n  background: var(--hancom-bg);\n  color: var(--hancom-body);\n  font-family: \"Pretendard\", \"Noto Sans KR\", -apple-system, BlinkMacSystemFont,\n    \"Segoe UI\", Arial, sans-serif;\n  -webkit-font-smoothing: antialiased;\n}\n\nh1 {\n  max-width: 820px;\n  margin-left: auto;\n  margin-right: auto;\n}\n\nh2 {\n  border-bottom: 1px solid var(--hancom-orange);\n}\n\np {\n  word-break: keep-all;\n  overflow-wrap: break-word;\n}\n\nimg, video, iframe {\n  max-width: 100%;\n}\n\nimg {\n  display: block;\n  object-fit: cover;\n}\n\ntable {\n  background: var(--hancom-surface);\n}\n\na {\n  transition: color 0.15s ease;\n}\n\n@media (max-width: 767px) {\n  h1 {\n    font-size: 24px;\n    line-height: 1.35;\n  }\n\n  h2 {\n    font-size: 19px;\n    margin-top: 32px;\n  }\n\n  p {\n    font-size: 13px;\n    line-height: 1.8;\n  }\n\n  table {\n    font-size: 12px;\n  }\n}\n"
